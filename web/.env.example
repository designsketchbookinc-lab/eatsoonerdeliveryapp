# Copy this file to .env.local and fill in the values from your Supabase project
# (Project Settings > API). The anon key is safe to use in the browser; row security
# in supabase/schema.sql decides what each person can see and do.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# The public web address of the app, used in sign-up confirmation emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
